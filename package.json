{
  "name": "revisaya",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:start": "SUPABASE_INTERNAL_IMAGE_REGISTRY=${SUPABASE_INTERNAL_IMAGE_REGISTRY:-docker.io} supabase start -x studio,imgproxy,vector,logflare,realtime,edge-runtime,supavisor,postgres-meta,postgrest",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "check:env": "node --conditions=react-server --experimental-strip-types --no-warnings scripts/check-env.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm db:test && pnpm test:integration && pnpm build",
    "db:types": "kysely-codegen",
    "test:e2e": "playwright test",
    "mailpit:smtp-url": "echo smtp://$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' supabase_inbucket_revisaya):1025",
    "stripe:mock": "docker start revisaya-stripe-mock 2>/dev/null || docker run -d --name revisaya-stripe-mock -p 12111:12111 stripe/stripe-mock:v0.206.0"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "decimal.js": "10.6.0",
    "exceljs": "^4.4.0",
    "kysely": "^0.29.8",
    "next": "16.4.5",
    "nodemailer": "^10.3.1",
    "papaparse": "^5.7.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "kysely-codegen": "^0.20.0",
    "pg": "^8.23.1",
    "supabase": "3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
