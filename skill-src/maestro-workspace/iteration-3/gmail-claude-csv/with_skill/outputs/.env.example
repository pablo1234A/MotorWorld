# Copia este archivo como .env (en la misma carpeta que el script) y rellena lo marcado con EDITAR.
# No compartas ni subas el .env a ningún repositorio: contiene tus claves.

# --- Gmail (EDITAR) ---
GMAILIA_USUARIO=tu.correo@gmail.com
# Contraseña de aplicación de 16 letras, NO tu contraseña normal (ver README, paso 2).
GMAILIA_APP_PASSWORD=abcd efgh ijkl mnop

# --- Claude (EDITAR) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Opcional ---
# A qué te dedicas, en una frase: ayuda a distinguir "cliente" de "otro". EDITAR o dejar vacío.
# Ejemplo: Soy diseñadora freelance; mis clientes son pequeñas empresas que me piden webs y logos.
GMAILIA_CONTEXTO=

# Modelo de Claude. El pequeño (Haiku) basta para clasificar; ver README antes de cambiarlo.
GMAILIA_MODELO=claude-haiku-5-5
# Cuánto "piensa" el modelo: low es suficiente. Déjalo vacío si usas un modelo antiguo (p. ej. claude-haiku-4-5).
GMAILIA_ESFUERZO=low

# Máximo de no leídos que se clasifican por ejecución (los más recientes). Limita el gasto.
GMAILIA_MAX_CORREOS=50

# Carpeta donde se guardan los CSV. Vacío = carpeta "resumenes" junto al script.
GMAILIA_CARPETA=

# Separador del CSV: ; para Excel en español, , para Excel en inglés o Google Sheets.
GMAILIA_SEPARADOR=;
