# Copia este archivo como .env (en la misma carpeta que el script) y rellena lo marcado EDITAR.
# No subas nunca el .env a git ni lo compartas: contiene tus claves.

# --- Obligatorio ---------------------------------------------------------------
# EDITAR: tu dirección de Gmail completa
GMAILCLAS_USUARIO=tu.nombre@gmail.com
# EDITAR: contraseña de APLICACIÓN de Google (16 letras), NO tu contraseña normal. Ver README.
GMAILCLAS_CLAVE_APP=abcdefghijklmnop
# EDITAR: clave de la API de Anthropic (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# --- Opcional (estos son los valores por defecto) --------------------------------
# Modelo de Claude. El pequeño y rápido sobra para clasificar; ver README para cuándo cambiarlo.
GMAILCLAS_MODELO=claude-haiku-5-5
# Esfuerzo de razonamiento: low | medium | high. Déjalo vacío si usas claude-haiku-4-5.
GMAILCLAS_ESFUERZO=low
# Solo se miran los no leídos de los últimos N días, y como mucho este número de correos (los más recientes).
GMAILCLAS_DIAS=7
GMAILCLAS_MAX_CORREOS=200
# Caracteres del cuerpo que se envían a Claude por correo (más = más contexto y más coste).
GMAILCLAS_MAX_CARACTERES=3000
# Carpeta IMAP a revisar. INBOX = Recibidos.
GMAILCLAS_CARPETA_IMAP=INBOX
# Filtro extra con la sintaxis del buscador de Gmail (sin tildes). Ejemplo para saltarte Promociones y Social:
# GMAILCLAS_FILTRO_GMAIL=-category:promotions -category:social
GMAILCLAS_FILTRO_GMAIL=
# Dónde guardar los CSV (ruta relativa a esta carpeta o absoluta).
GMAILCLAS_CARPETA_SALIDA=resumenes
# Separador del CSV: ; abre bien en Excel en español. Usa , para Google Sheets/Excel en inglés, o tab.
GMAILCLAS_CSV_SEPARADOR=;
# 1 = si algo falla te llega un correo a ti mismo con el motivo. 0 = desactivado.
GMAILCLAS_AVISO_FALLO=1
