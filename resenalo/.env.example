# ───────────── Reseñalo — configuración de ejemplo ─────────────
# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

NODE_ENV=production
# URL pública (con https en producción). Se usa en enlaces, OAuth y CSRF.
APP_URL=https://app.tudominio.es
PORT=3000

# PostgreSQL 14+ y Redis 6.2+
DATABASE_URL=postgresql://resenalo:CAMBIAR@localhost:5432/resenalo
REDIS_URL=redis://127.0.0.1:6379

# Clave(s) de cifrado AES-256 (32 bytes en base64) para tokens OAuth y secretos.
# Generar:  node -e "console.log('v1:'+require('crypto').randomBytes(32).toString('base64'))"
# Rotación: "v2:NUEVA,v1:ANTIGUA" (la primera cifra; las demás solo descifran).
ENCRYPTION_KEYS=v1:CAMBIAR_POR_UNA_CLAVE_ALEATORIA_DE_32_BYTES_BASE64

SESSION_TTL_DAYS=30
LOG_LEVEL=info
WORKER_CONCURRENCY=5

# ── Correo transaccional de la plataforma (verificación, recuperación, avisos) ──
# Usa un proveedor SMTP (Amazon SES, Postmark, Brevo, Mailgun…). No es la cuenta de los clientes.
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Reseñalo <no-reply@tudominio.es>"
# Recibe avisos de solicitudes RGPD
ADMIN_NOTIFICATIONS_EMAIL=privacidad@tudominio.es

# ── Stripe Billing ──
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs de precio (los crea `npm run stripe:setup`)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...
# true = Stripe Tax (recomendado: IVA por país, OSS, inversión del sujeto pasivo B2B UE)
STRIPE_AUTOMATIC_TAX=true
# Solo si STRIPE_AUTOMATIC_TAX=false: tasa de impuesto INCLUSIVA del 21 % creada en Stripe
STRIPE_TAX_RATE_ID=

# ── Google OAuth (Gmail API) ──  Redirect URI: ${APP_URL}/api/v1/email-connection/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft OAuth (Graph) ──  Redirect URI: ${APP_URL}/api/v1/email-connection/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ── Monitorización de errores (opcional): webhook que recibe JSON {text, context, stack}
ERROR_WEBHOOK_URL=

# ── Datos legales del titular (aparecen en Aviso legal, Privacidad y Condiciones) ──
# Si se dejan vacíos, las páginas legales muestran «PENDIENTE DE COMPLETAR».
LEGAL_OWNER_NAME=
LEGAL_OWNER_TAX_ID=
LEGAL_OWNER_ADDRESS=
LEGAL_OWNER_REGISTRY=
LEGAL_CONTACT_EMAIL=
LEGAL_DPO_EMAIL=
