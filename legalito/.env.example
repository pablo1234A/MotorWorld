# =============================================================================
# Legalito · Variables de entorno (copia a .env.local y completa)
# NUNCA subas valores reales al repositorio. Las variables sin NEXT_PUBLIC_
# solo existen en el servidor.
# =============================================================================

# Entorno: development | test | staging | production
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Settings → API) ------------------------------------------------
# Las NEXT_PUBLIC_* deben existir también durante el build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role: ignora RLS. Solo servidor. No exponer jamás.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (empieza SIEMPRE en modo test: sk_test_...) -----------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Cobros reales: requiere APP_ENV=production + clave sk_live_ + esta variable a true.
STRIPE_LIVE_PAYMENTS_ENABLED=false
# Activar solo si Stripe Tax está configurado en la cuenta.
STRIPE_AUTOMATIC_TAX=false

# --- Resend --------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Legalito <hola@tudominio.es>"
EMAIL_REPLY_TO=
# Recibe las notificaciones de nuevas consultas de soporte.
SUPPORT_EMAIL=

# --- Plantillas ----------------------------------------------------------------
# Permite generar con plantillas DE DEMOSTRACIÓN (marcadas como no válidas).
# Prohibido en producción: la aplicación no arranca si se activa con APP_ENV=production.
ALLOW_DEMO_TEMPLATES=true

# --- Seguridad -----------------------------------------------------------------
# Sal para seudonimizar IP en límites de frecuencia y auditoría (32+ caracteres aleatorios).
HASH_SALT=

# --- Datos públicos del titular de Legalito (páginas legales propias) ---------
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@tudominio.es
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_COMPANY_NIF=
NEXT_PUBLIC_LEGAL_COMPANY_ADDRESS=
NEXT_PUBLIC_LEGAL_COMPANY_REGISTRY=
NEXT_PUBLIC_LEGAL_COMPANY_EMAIL=
# Poner a true SOLO cuando un profesional haya revisado las páginas legales propias.
NEXT_PUBLIC_LEGAL_PAGES_REVIEWED=false

# --- Pruebas -------------------------------------------------------------------
# PostgreSQL local para las pruebas de RLS (npm run test:db).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
