# ─── AI PRODUCT COMPANY — environment ────────────────────────────
# Copy to .env and fill in. NEVER commit .env. Secrets live only on the server.

# Server
PORT=8787
HOST=127.0.0.1
# Where the SQLite database and media (videos, product images) are stored
DATA_DIR=./data
# Long random string used to sign nothing client-side; sessions are opaque random tokens.
# Set to "true" when served behind HTTPS so cookies get the Secure flag.
COOKIE_SECURE=false

# ─── LLM (agents' brain) ─────────────────────────────────────────
# Without a key the company runs on the LOCAL HEURISTIC ENGINE (clearly flagged
# in the UI as INTEGRATION_REQUIRED). With a key, every agent thinks with Claude.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# ─── Local render engine ─────────────────────────────────────────
# ffmpeg path (the built-in render/animatic engine). Leave empty to auto-detect.
FFMPEG_PATH=
FFPROBE_PATH=
# TTF/OTF font used for burned-in subtitles. Leave empty to auto-detect.
FONT_FILE=

# ─── Shopify (INTEGRATION_REQUIRED until configured) ─────────────
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
