{
  "name": "@presupio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:bootstrap": "tsx --env-file-if-exists=../../.env scripts/db-bootstrap.ts",
    "db:bootstrap:prod": "node --env-file-if-exists=../../.env dist/scripts/db-bootstrap.js",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.ts",
    "db:migrate:prod": "node --env-file-if-exists=../../.env dist/scripts/migrate.js",
    "db:seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "worker:start": "node --env-file-if-exists=../../.env dist/src/worker.js",
    "ops": "tsx --env-file-if-exists=../../.env scripts/ops.ts",
    "ops:prod": "node --env-file-if-exists=../../.env dist/scripts/ops.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "kysely": "^0.29.7",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "stripe": "23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.21.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
