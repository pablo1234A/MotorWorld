# Presupio · Variables de entorno (ejemplo, sin secretos reales).
# Copia este archivo a .env y ajusta los valores. .env NUNCA se sube al repositorio.

# --- Servidor -------------------------------------------------------------
NODE_ENV=development            # development | test | production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
# Detrás de un proxy (nginx): IPs o redes de los proxies de confianza, separadas por comas.
# «loopback» si nginx está en la misma máquina. No admite nº de saltos (Fastify los ignora).
# Sin él, todos los clientes comparten la IP del proxy en los límites por IP.
TRUST_PROXY=false

# --- Base de datos (PostgreSQL 15+) ----------------------------------------
# Rol de la APLICACIÓN: solo lee/escribe datos; sin DDL, sin superusuario, sin BYPASSRLS.
DATABASE_URL=postgres://presupio_app:cambia_esta_clave_app@localhost:5432/presupio
# Rol PROPIETARIO del esquema: solo para ejecutar migraciones (npm run db:migrate).
MIGRATION_DATABASE_URL=postgres://presupio_owner:cambia_esta_clave_owner@localhost:5432/presupio
DB_POOL_MAX=10

# Solo desarrollo local: superusuario para crear roles y bases de datos (npm run db:bootstrap).
# Contraseña del PostgreSQL LOCAL de docker-compose.yml (solo tu máquina; por defecto «postgres»).
# PRESUPIO_LOCAL_PG_PASSWORD=
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

# Pruebas automáticas: base de datos aparte cuyo nombre DEBE terminar en _test.
TEST_DATABASE_URL=postgres://presupio_app:cambia_esta_clave_app@localhost:5432/presupio_test
TEST_MIGRATION_DATABASE_URL=postgres://presupio_owner:cambia_esta_clave_owner@localhost:5432/presupio_test

# --- Aplicación web y sesiones ---------------------------------------------
# URL del frontend: se usa en los enlaces de los emails y como origen CORS por defecto.
APP_WEB_URL=http://localhost:5173
# Orígenes permitidos (separados por comas). Por defecto, APP_WEB_URL. Nunca "*".
# CORS_ORIGINS=http://localhost:5173
# Cookie solo por HTTPS. Por defecto true en producción (obligatorio) y false en desarrollo.
# COOKIE_SECURE=true
SESSION_TTL_HOURS=720           # duración máxima de una sesión (30 días)
SESSION_IDLE_TIMEOUT_HOURS=168  # cierre por inactividad (7 días)

# Límite global de peticiones a la API por IP y minuto (los de login y registro son aparte).
# Los contadores se guardan en PostgreSQL: valen para todas las instancias y sobreviven a reinicios.
RATE_LIMIT_PER_MINUTE=600
# Altas de empresa por IP y hora (por defecto 10).
# RATE_LIMIT_REGISTER_PER_HOUR=10

# Días de prueba gratuita (con límites de Starter) al registrarse. 0 = sin prueba.
TRIAL_DAYS=14
# Un dominio de empresa (no gmail, hotmail…) solo abre una prueba en este plazo. 0 = sin esta regla.
# La regla de una prueba por email (normalizado) se aplica siempre. Ver docs/facturacion.md.
TRIAL_DOMAIN_RULE_DAYS=365
# Días antes del fin de la prueba en que se avisa por email a los propietarios. Vacío = sin avisos.
TRIAL_REMINDER_DAYS=3,1

# --- Documentos legales ------------------------------------------------------
# OBLIGATORIAS en producción: direcciones (https) de las versiones PUBLICADAS Y REVISADAS de los
# términos y de la política de privacidad, que el alta pide aceptar. docs/legal/ solo tiene borradores.
# LEGAL_TERMS_URL=https://tu-dominio.es/terminos
# LEGAL_PRIVACY_URL=https://tu-dominio.es/privacidad

# --- Correo ---------------------------------------------------------------
# disabled: no se envía nada (y la API lo indica).
# log:      solo desarrollo; muestra el email en la consola (prohibido en producción).
# smtp:     envío real.
MAIL_TRANSPORT=disabled
MAIL_FROM="Presupio <no-reply@tu-dominio.es>"
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_SECURE=false               # true para el puerto 465
SMTP_USER=usuario_smtp
SMTP_PASSWORD=cambia_esta_clave_smtp

# --- Envío automático de emails de seguimiento (fase 3) ------------------------
# Ver docs/automatizacion.md. Con "disabled" no se envía nada y la aplicación lo indica.
# disabled | mailgun | smtp (smtp reutiliza MAIL_TRANSPORT=smtp y SMTP_*; sin confirmación de entrega)
FOLLOWUP_EMAIL_PROVIDER=disabled
# Remitente técnico de un dominio verificado en el proveedor. El nombre visible es el de cada empresa.
# FOLLOWUP_FROM_EMAIL=seguimiento@envios.tu-dominio.es
# Mailgun, región UE. Clave de API y clave de firma de webhooks: SECRETOS, solo en el gestor de secretos.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=envios.tu-dominio.es
# MAILGUN_API_BASE=https://api.eu.mailgun.net
# MAILGUN_WEBHOOK_SIGNING_KEY=
# Detección de respuestas de clientes (correo entrante, solo con Mailgun). Dominio de recepción
# con MX hacia Mailgun y una ruta forward() a /api/v1/webhooks/inbound/mailgun. Ver docs/automatizacion.md.
# INBOUND_EMAIL_DOMAIN=respuestas.tu-dominio.es
# URL pública de la API (baja de un clic, List-Unsubscribe). Por defecto, APP_WEB_URL.
# PUBLIC_API_URL=https://app.tu-dominio.es
WORKER_INTERVAL_SECONDS=60       # cada cuánto se ejecuta el proceso de envío (npm run worker)
FOLLOWUP_MAX_ATTEMPTS=3          # reintentos técnicos por email ante errores temporales (1-5); no consumen intentos del plan
MESSAGE_CONTENT_RETENTION_DAYS=90  # días que se conserva el texto de cada email enviado

# --- Supervisión (fase 4) --------------------------------------------------------
# Token para que un monitor externo consulte GET /api/v1/ops/status (Authorization: Bearer …).
# Mínimo 32 caracteres; genera uno con: openssl rand -hex 32. Sin él, la ruta no existe.
# OPS_STATUS_TOKEN=

# --- Datos de demostración (npm run db:seed, solo desarrollo) ---------------
# SEED_EMAIL=demo@presupio.test
# SEED_PASSWORD=

# --- Pagos con Stripe (fase 5) — SOLO MODO DE PRUEBA -----------------------------
# Sin PAYMENTS_ENABLED=true, Presupio funciona como antes: prueba gratuita y planes
# asignados con `npm run ops`. Las claves live (sk_live_, rk_live_, pk_live_) se rechazan
# al arrancar. Nunca escribas aquí claves reales: usa el .env local (no se versiona).
# Guía: docs/facturacion.md
# PAYMENTS_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...          # clave secreta de PRUEBA (o restringida rk_test_...)
# STRIPE_WEBHOOK_SECRET=whsec_...        # secreto del endpoint /api/v1/webhooks/stripe
# STRIPE_PRICE_STARTER=price_...         # precio mensual 27,99 EUR
# STRIPE_PRICE_PRO=price_...             # precio mensual 57,99 EUR
# STRIPE_PRICE_BUSINESS=price_...        # precio mensual 127,99 EUR
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_... # opcional: configuración del portal de cliente
# Presentación de precios respecto al IVA (no configura impuestos): pending | included | excluded
# PRICES_TAX_DISPLAY=pending
