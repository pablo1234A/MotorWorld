# Presupio · Variables de entorno (ejemplo, sin secretos reales).
# Copia este archivo a .env y ajusta los valores. .env NUNCA se sube al repositorio.

# --- Servidor -------------------------------------------------------------
NODE_ENV=development            # development | test | production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
# Detrás de un proxy/balanceador: true, false o nº de saltos de confianza (p. ej. 1)
TRUST_PROXY=false

# --- Base de datos (PostgreSQL 15+) ----------------------------------------
# Rol de la APLICACIÓN: solo lee/escribe datos; sin DDL, sin superusuario, sin BYPASSRLS.
DATABASE_URL=postgres://presupio_app:cambia_esta_clave_app@localhost:5432/presupio
# Rol PROPIETARIO del esquema: solo para ejecutar migraciones (npm run db:migrate).
MIGRATION_DATABASE_URL=postgres://presupio_owner:cambia_esta_clave_owner@localhost:5432/presupio
DB_POOL_MAX=10

# Solo desarrollo local: superusuario para crear roles y bases de datos (npm run db:bootstrap).
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

# Pruebas automáticas: base de datos aparte cuyo nombre DEBE terminar en _test.
TEST_DATABASE_URL=postgres://presupio_app:cambia_esta_clave_app@localhost:5432/presupio_test
TEST_MIGRATION_DATABASE_URL=postgres://presupio_owner:cambia_esta_clave_owner@localhost:5432/presupio_test

# --- Aplicación web y sesiones ---------------------------------------------
# URL del frontend: se usa en los enlaces de los emails y como origen CORS por defecto.
APP_WEB_URL=http://localhost:5173
# Orígenes permitidos (separados por comas). Por defecto, APP_WEB_URL. Nunca "*".
# CORS_ORIGINS=http://localhost:5173
# Cookie solo por HTTPS. Por defecto true en producción (obligatorio) y false en desarrollo.
# COOKIE_SECURE=true
SESSION_TTL_HOURS=720           # duración máxima de una sesión (30 días)
SESSION_IDLE_TIMEOUT_HOURS=168  # cierre por inactividad (7 días)

# Días de prueba gratuita (con límites de Starter) al registrarse. 0 = sin prueba.
TRIAL_DAYS=14

# --- Correo ---------------------------------------------------------------
# disabled: no se envía nada (y la API lo indica).
# log:      solo desarrollo; muestra el email en la consola (prohibido en producción).
# smtp:     envío real.
MAIL_TRANSPORT=disabled
MAIL_FROM="Presupio <no-reply@tu-dominio.es>"
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_SECURE=false               # true para el puerto 465
SMTP_USER=usuario_smtp
SMTP_PASSWORD=cambia_esta_clave_smtp

# --- Datos de demostración (npm run db:seed, solo desarrollo) ---------------
# SEED_EMAIL=demo@presupio.test
# SEED_PASSWORD=
