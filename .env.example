# ─── World Builder AI · variables de entorno ───────────────────────────────
# Copia este archivo a .env.local y rellena solo lo que vayas a usar.
# Todas las claves se leen EXCLUSIVAMENTE en el servidor. Nunca se envían al navegador.

# URL pública de la app (se usa en sitemaps, formularios de sitios exportados y enlaces de publicación)
APP_URL=http://localhost:3000

# IA — Claude Opus 5.5 (https://console.anthropic.com). Sin clave se usa el motor local determinista.
ANTHROPIC_API_KEY=
# Modelo (no cambiar salvo decisión explícita)
WB_MODEL=claude-opus-5-5

# Base de datos. Vacío = PGlite embebido en .data/pglite (desarrollo).
# Producción: cadena de conexión de Neon o Supabase (Postgres).
DATABASE_URL=

# Imágenes de stock (opcional, con atribución automática)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Email de avisos de formularios (https://resend.com)
RESEND_API_KEY=
RESEND_FROM=World Builder <onboarding@resend.dev>

# Pagos (https://dashboard.stripe.com/apikeys). Para Payment Links no hace falta clave.
STRIPE_SECRET_KEY=

# Despliegue en Vercel (https://vercel.com/account/tokens)
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Almacenamiento de subidas (local por defecto)
UPLOAD_DIR=.data/uploads
MAX_UPLOAD_MB=8
