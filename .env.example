# =============================================================================
# AnunciaPro · Variables de entorno
# Copia este archivo a .env.local y rellena los valores. Nunca subas secretos.
# Documentación completa: docs/VARIABLES-ENTORNO.md · Comprobación: pnpm check:env
# =============================================================================

# --- OBLIGATORIAS -----------------------------------------------------------
# URL pública de la aplicación (sin barra final).
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Proyecto de Supabase (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (anon / publishable). Es segura en el navegador: RLS protege los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta (service_role / secret). SOLO servidor. Necesaria para el panel de
# administración, eliminación de cuentas, webhooks de Stripe, cron y limitación de peticiones.
SUPABASE_SERVICE_ROLE_KEY=

# --- PAGOS (opcionales mientras PAYMENTS_ENABLED=false) ---------------------
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- GENERACIÓN (opcional) --------------------------------------------------
# "template" (por defecto, sin coste) o "anthropic" (requiere ANTHROPIC_API_KEY).
AI_PROVIDER=template
ANTHROPIC_API_KEY=
# Modelo cuando AI_PROVIDER=anthropic (por defecto: claude-opus-5-5).
AI_MODEL=

# --- OPERACIÓN (opcionales) -------------------------------------------------
# Secreto para /api/cron/process-jobs (Vercel Cron lo envía como Bearer).
CRON_SECRET=
# Nivel de log: debug | info | warn | error
LOG_LEVEL=info
