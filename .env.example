# ===================== MotorWorld Studio — configuration =====================
# Copy to .env and fill in. NEVER commit .env. Keys stay server-side only.

# --- Core (required in production) ---
ENVIRONMENT=production
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
PUBLIC_WEB_URL=http://localhost
CORS_ORIGINS=http://localhost
COOKIE_SECURE=false            # true when served over HTTPS
SITE_ADDRESS=:80               # your domain (studio.example.com) enables automatic HTTPS in Caddy
LOG_JSON=true
LOG_LEVEL=INFO

# --- Infrastructure (docker compose) ---
POSTGRES_USER=motorworld
POSTGRES_PASSWORD=
POSTGRES_DB=motorworld
MINIO_ROOT_USER=motorworld
MINIO_ROOT_PASSWORD=
S3_BUCKET=motorworld
# Public URL the BROWSER uses to download media (presigned links):
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# Set true only if the bucket endpoint is reachable from the internet (providers fetch inputs by URL):
S3_PRESIGN_FOR_PROVIDERS=false
# Supabase option: point DATABASE_URL at Supabase Postgres and S3_* at Supabase Storage's S3 endpoint.

# --- Limits ---
MAX_UPLOAD_MB=500
MAX_ACTIVE_JOBS_PER_USER=4
DAILY_GENERATION_LIMIT=300
USER_STORAGE_QUOTA_MB=20000
RATE_LIMIT_PER_MINUTE=600
GENERATE_CONCURRENCY=20
MEDIA_CONCURRENCY=2

# --- Email (password reset). Without SMTP, reset links are only logged in dev. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MotorWorld Studio <no-reply@example.com>

# --- AI providers (all optional; add the ones you have) ---
# Hugging Face Inference Providers — small free monthly credit (FLUX.1-schnell, SDXL)
HF_TOKEN=
# Replicate — pay per use (FLUX, Kling, Wan, Veo, Seedance, Hailuo, MusicGen…)
REPLICATE_API_TOKEN=
# fal.ai — pay per use (FLUX, Kling, Wan, Veo, LTX, Hunyuan, Luma, Stable Audio, MMAudio…)
FAL_KEY=
# Black Forest Labs direct API — FLUX pro / Kontext / Fill
BFL_API_KEY=
# ElevenLabs — TTS / SFX / music (free tier is non-commercial)
ELEVENLABS_API_KEY=
# Screenplay LLM: Anthropic Claude…
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# …or any OpenAI-compatible server (free local example: Ollama)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# Self-hosted ComfyUI (free, your GPU)
COMFYUI_URL=
COMFYUI_SDXL_CKPT=sd_xl_base_1.0.safetensors
COMFYUI_FLUX_SCHNELL_CKPT=flux1-schnell-fp8.safetensors
# Local Diffusers on a GPU worker (docker compose --profile gpu)
LOCAL_DIFFUSERS_ENABLED=false
# Allow users to add their own provider keys (stored encrypted)
ALLOW_USER_API_KEYS=true

# --- Free stock media ---
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
