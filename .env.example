# =============================================================================
# RevisaYa — variables de entorno (copiar a .env.local y rellenar).
# NUNCA subas valores reales al repositorio. Solo las variables NEXT_PUBLIC_*
# llegan al navegador y ninguna de ellas es un secreto.
# Validación: src/server/env.ts
# =============================================================================

APP_ENV=local                      # local | staging | production
APP_URL=http://localhost:3000

# --- Supabase (los valores locales los muestra `pnpm db:start`) --------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Conexión directa/pooler (modo transacción en staging/producción).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_POOL_MAX=10

# --- Secretos internos (genera cada uno con: openssl rand -base64 48) -------
# Protege /api/internal/jobs/* (Vercel Cron lo envía como Bearer).
CRON_SECRET=
BOOKING_TOKEN_SECRET=
API_KEY_PEPPER=
# 32 bytes en base64 (openssl rand -base64 32). Cifra los tokens de Google.
INTEGRATIONS_ENCRYPTION_KEY=

# --- Correo -----------------------------------------------------------------
# Sin EMAIL_PROVIDER no se envía nada (los avisos quedan programados).
# Local: smtp hacia Mailpit (la IP del contenedor: pnpm mailpit:smtp-url).
EMAIL_PROVIDER=                    # smtp | resend
SMTP_URL=                          # smtp://usuario:clave@host:587 (SES, Mailpit…)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=            # whsec_… (panel de Resend → Webhooks). Sin él, el webhook responde 503
EMAIL_SHARED_DOMAIN=avisos.revisaya.es
# Firma de los enlaces de baja (openssl rand -base64 48)
EMAIL_LINK_SECRET=

# --- Stripe (Fase 8) — SIEMPRE claves TEST (sk_test_ / pk_test_) -------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Solo el responsable adulto del proyecto puede ponerlo a true, en producción,
# tras revisar obligaciones fiscales y legales. Con false, una clave sk_live_
# impide arrancar la aplicación.
PAYMENTS_LIVE_ENABLED=false

# --- Google Calendar (Fase 9) ------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Anti-spam y observabilidad ---------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SENTRY_DSN=
