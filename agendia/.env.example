# ---- IA (obligatorio) ----
# Clave de https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modelo (opcional). Por defecto: claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# ---- Google Calendar + Gmail (opcional: sin esto funciona en modo demo) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Servidor ----
PORT=3000
# URL pública donde corre Agendia (se usa para OAuth y el código del widget)
PUBLIC_URL=http://localhost:3000
# Contraseña del panel. Obligatoria si lo publicas en internet.
ADMIN_PASSWORD=
# Clave para cifrar los tokens de Google (si no se define, se genera en data/.secret)
# SECRET_KEY=
